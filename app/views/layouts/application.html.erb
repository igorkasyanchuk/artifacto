<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Artifacto" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Artifacto">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Named, not :app — that would bundle every sheet in the directory, including
        artifact.css, which belongs to the wrapper page alone. %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= "auth" if devise_controller? %>">
    <% if (notice || alert) && !content_for?(:flash_handled) %>
      <p class="flash"><%= notice || alert %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
