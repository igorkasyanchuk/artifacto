<% content_for :title, @artifact.title.presence || "Artifact" %>
<%# The unlock token is what proves the PIN was entered; the comments API takes
    the same one the content zone does, so a locked artifact's comments stay locked. %>
<div class="viewer" data-controller="wrapper" data-wrapper-slug-value="<%= @artifact.slug %>"
     data-wrapper-token-value="<%= @unlock_token %>">
  <div class="bar">
    <strong><%= @artifact.title.presence || "Untitled artifact" %></strong>
    <span class="<%= @artifact.ttl_days <= 3 ? "warn" : "note" %>">
      expires in <%= pluralize(@artifact.ttl_days, "day") %>
    </span>
    <span class="note"><%= pluralize(@artifact.view_count, "view") %></span>
    <span class="note" data-wrapper-target="count"></span>
    <% if @artifact.allow_network? %>
      <span class="warn">can make network requests</span>
    <% end %>
    <span class="spacer"></span>
    <% unless @needs_pin %>
      <button data-wrapper-target="toggle" data-action="wrapper#toggle">Comment</button>
    <% end %>
    <button data-action="wrapper#copy">Copy link</button>
    <%= form_with url: report_artifact_path(@artifact.slug), method: :post, class: "check" do |form| %>
      <%= form.select :reason, AbuseReport::REASONS.map { |r| [ r.capitalize, r ] } %>
      <%= form.submit "Report" %>
    <% end %>
  </div>

  <% if flash[:notice] || flash[:alert] %>
    <div class="flash"><%= flash[:notice] || flash[:alert] %></div>
  <% end %>

  <% if @needs_pin %>
    <div class="center">
      <h1>This artifact is locked</h1>
      <%= form_with url: unlock_artifact_path(@artifact.slug), method: :post do |form| %>
        <%= form.password_field :pin, placeholder: "PIN", autocomplete: "off" %>
        <p><%= form.submit "Unlock", class: "primary" %></p>
      <% end %>
    </div>
  <% else %>
    <div class="stage">
      <iframe class="frame" src="<%= @iframe_src %>" data-wrapper-target="frame"
              title="<%= @artifact.title.presence || "Artifact" %>"></iframe>

      <%# Pins and threads are drawn here, on the app origin. The artifact only
          ever reports coordinates — it never receives a comment body. %>
      <div class="overlay" data-wrapper-target="overlay"></div>

      <form class="panel thread" hidden data-wrapper-target="panel" data-action="submit->wrapper#submit">
        <p class="note" data-wrapper-target="quote"></p>
        <div data-wrapper-target="list"></div>
        <textarea rows="3" placeholder="Leave a comment" maxlength="<%= Comment::MAX_BODY %>"
                  data-wrapper-target="body"></textarea>
        <p class="warn" hidden data-wrapper-target="error"></p>
        <p class="check">
          <button class="primary">Comment</button>
          <button type="button" data-action="wrapper#close">Cancel</button>
        </p>
      </form>
    </div>
  <% end %>
</div>
