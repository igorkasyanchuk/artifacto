<% content_for :title, @artifact.title.presence || "Artifact" %>
<% content_for :flash_handled, true %>
<%# The unlock token is what proves the PIN was entered; the comments API takes
    the same one the content zone does, so a locked artifact's comments stay locked. %>
<%# blur@window covers the click that lands in the iframe: those events never
    reach this document, and the artifact is the likeliest place to click next. %>
<div class="viewer" data-controller="wrapper" data-wrapper-slug-value="<%= @artifact.slug %>"
     data-wrapper-token-value="<%= @unlock_token %>"
     data-action="click@document->wrapper#dismissMenu blur@window->wrapper#dismissMenu
                  keydown@document->wrapper#key">
  <header class="bar">
    <a class="home-link" href="<%= root_path %>" title="artifacto">
      <%= image_tag "/icon.svg", class: "mark", alt: "artifacto" %>
    </a>
    <span class="crumb" aria-hidden="true">/</span>
    <strong class="bar-title" title="<%= @artifact.title.presence || "Untitled artifact" %>">
      <%= @artifact.title.presence || "Untitled artifact" %>
    </strong>

    <span class="chips">
      <span class="chip <%= "is-warn" if @artifact.ttl_days <= 3 %>">
        ttl <%= @artifact.ttl_days %>d
      </span>
      <span class="chip"><%= pluralize(@artifact.view_count, "view") %></span>
      <% if @artifact.allow_network? %>
        <span class="chip is-warn">network on</span>
      <% end %>
      <span class="chip is-warn" hidden data-wrapper-target="status"></span>
    </span>

    <span class="spacer"></span>

    <div class="actions">
      <% unless @needs_pin %>
        <div class="seg" role="group" aria-label="Comments">
          <button class="mode" aria-pressed="false" title="Comment mode (c)"
                  data-wrapper-target="toggle" data-action="wrapper#toggle">
            <span class="led" aria-hidden="true"></span>comment<kbd>c</kbd>
          </button>
          <button aria-pressed="false" title="All comments (l)" data-wrapper-target="listToggle" data-action="wrapper#drawer">
            threads<span class="badge" hidden data-wrapper-target="count"></span><kbd>l</kbd>
          </button>
          <button aria-pressed="true" title="Show or hide pins (p)" data-wrapper-target="pins" data-action="wrapper#togglePins">
            pins<kbd>p</kbd>
          </button>
        </div>
      <% end %>
      <button data-action="wrapper#copy" title="Copy link">copy link</button>

      <%# Report is a rare, deliberate action and a two-control form: it costs the
          bar more room than it is worth open. A <details> is the whole disclosure. %>
      <details class="menu">
        <summary title="More">⋯</summary>
        <div class="menu-body">
          <%= form_with url: report_artifact_path(@artifact.slug), method: :post do |form| %>
            <label for="reason">Report this artifact</label>
            <%= form.select :reason, AbuseReport::REASONS.map { |r| [ r.capitalize, r ] } %>
            <p class="stack"><%= form.submit "Report" %></p>
          <% end %>
        </div>
      </details>
    </div>
  </header>

  <%# Empty on purpose, and empty is also how it hides: it stays in the page so
      that a screen reader is still watching it when its text arrives. %>
  <p class="toast" role="status" data-wrapper-target="toast"></p>

  <% if flash[:notice] || flash[:alert] %>
    <div class="flash"><%= flash[:notice] || flash[:alert] %></div>
  <% end %>

  <% if @needs_pin %>
    <div class="center">
      <p class="code">401 · pin required</p>
      <h1>Locked</h1>
      <p class="note">Whoever published this artifact set a PIN on it.</p>
      <%= form_with url: unlock_artifact_path(@artifact.slug), method: :post do |form| %>
        <%= form.password_field :pin, placeholder: "PIN", autocomplete: "off", autofocus: true %>
        <p><%= form.submit "Unlock", class: "primary" %></p>
      <% end %>
    </div>
  <% else %>
    <div class="stage">
      <%# The frame's own load event is the only moment its message listener is
          certainly attached: artifacto:ready can be sent before Stimulus has
          connected here, and the send that follows the comments fetch races the
          frame's parser. Sending again here costs one postMessage. %>
      <%# The sandbox attribute, not only the CSP header: the header covers the
          first document alone, while the attribute holds for anything the frame
          navigates itself to. Nothing stops a frame loading an outside page, but that
          page stays opaque, popup-less and unable to navigate the top window. %>
      <iframe class="frame" src="<%= @iframe_src %>" data-wrapper-target="frame"
              sandbox="<%= RawController.sandbox_flags %>"
              data-action="load->wrapper#sendAnchors"
              title="<%= @artifact.title.presence || "Artifact" %>"></iframe>

      <%# Pins and threads are drawn here, on the app origin. The artifact only
          ever reports coordinates — it never receives a comment body. %>
      <div class="overlay" data-wrapper-target="overlay"></div>

      <%# Says the mode out loud on this side of the frame; the cursor and the
          hover outline inside it are the other half. %>
      <p class="modeline" aria-hidden="true">
        <span class="led"></span> comment mode — click any spot on the page
        <span class="modeline-exit"><kbd>esc</kbd> to exit</span>
      </p>

      <form class="thread" hidden data-wrapper-target="panel" data-action="submit->wrapper#submit">
        <header>
          <p class="thread-quote" data-wrapper-target="quote"></p>
          <button type="button" class="icon" aria-label="Close" data-action="wrapper#close">×</button>
        </header>
        <div class="thread-list" data-wrapper-target="list"></div>
        <div class="composer">
          <textarea rows="3" placeholder="Leave a comment…" maxlength="<%= Comment::MAX_BODY %>"
                    aria-label="Comment" data-wrapper-target="body"
                    data-action="keydown.meta+enter->wrapper#send keydown.ctrl+enter->wrapper#send"></textarea>
          <p class="warn" hidden data-wrapper-target="error"></p>
          <div class="composer-foot">
            <input type="text" placeholder="name (optional)" autocomplete="name" aria-label="Your name"
                   maxlength="<%= Comment::MAX_AUTHOR %>" data-wrapper-target="author">
            <button class="primary">post<kbd>⌘↵</kbd></button>
          </div>
        </div>
      </form>

      <%# Every comment on the artifact in one list, whether or not its anchor
          still resolves. Deleting is the artifact owner's move, so it is the edit
          token that authorises it — not this page. %>
      <aside class="drawer" hidden aria-label="Comments" data-wrapper-target="drawer">
        <header>
          <strong>threads</strong>
          <span class="spacer"></span>
          <button type="button" class="icon" aria-label="Close" data-action="wrapper#drawer">×</button>
        </header>
        <div class="entries" data-wrapper-target="entries"></div>
      </aside>
    </div>
  <% end %>
</div>
